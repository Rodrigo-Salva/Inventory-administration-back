# ============================================================================
# Plantilla de configuracion. Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
# `.env` esta en .gitignore: NUNCA lo subas a git. Este archivo SI se versiona, sin secretos.
# ============================================================================

# --- Base de datos (obligatoria) --------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/inventory_saas
# Pruebas de integracion (opcional; por defecto usa <DATABASE_URL>_test). El nombre DEBE terminar en _test.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/inventory_saas_test

# --- Seguridad (obligatoria) -------------------------------------------------
# Genera una clave larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Intentos de login/registro por IP (fuerza bruta)
AUTH_RATE_LIMIT=5/minute
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Entorno -----------------------------------------------------------------
ENVIRONMENT=development        # development | production (en production se exigen SECRET_KEY >= 32 y CORS explicito)
LOG_LEVEL=INFO
ENABLE_DOCS=true               # /docs y /redoc (se desactivan solos en production)

# --- Redis (opcional: sin Redis la cache se deshabilita) ---------------------
REDIS_URL=redis://localhost:6379/0

# --- IA (opcional) -----------------------------------------------------------
GOOGLE_API_KEY=

# --- Pagos: Mercado Pago (opcional) -----------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Precio de cada plan lo define el servidor. Ejemplo: {"premium": 49.90}
SUBSCRIPTION_PLANS={}
SUBSCRIPTION_CURRENCY=PEN

# --- Correo para alertas de stock (opcional) --------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Observabilidad (opcional) ----------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Datos de ejemplo: python -m app.infrastructure.seeds.seed_data ----------
SEED_ADMIN_EMAIL=admin@demo.com
# Si lo dejas vacio se genera una contrasena aleatoria y se muestra una sola vez
SEED_ADMIN_PASSWORD=

# --- Solo para Docker Compose (docker/docker-compose.yml) -------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=inventory_saas
# PGADMIN_EMAIL=admin@inventory.com
# PGADMIN_PASSWORD=
# APP_PORT=8000
# RUN_SEEDS=false
